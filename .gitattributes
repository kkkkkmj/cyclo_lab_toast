*.usd filter=lfs diff=lfs merge=lfs -text
*.usda filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.dae filter=lfs diff=lfs merge=lfs -text
*.mtl filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.jit filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text

# Legacy assets were committed as normal Git blobs before the CycloLab rename.
# Keep those moved files as blobs so GitHub can display them as renames.
source/cyclo_lab/data/object/*.usd -filter -diff -merge -text
source/cyclo_lab/data/robots/FFW/FFW_BG2.usd -filter -diff -merge -text
source/cyclo_lab/data/robots/FFW/FFW_BG2_without_mimic.usd -filter -diff -merge -text
source/cyclo_lab/data/robots/FFW/FFW_SG2.usd -filter -diff -merge -text
source/cyclo_lab/data/robots/OMY/OMY.usd -filter -diff -merge -text

# Store only the newly added high-resolution object textures in LFS. A global
# PNG rule would also rewrite all legacy texture blobs when staging this change.
source/cyclo_lab/data/object/texture/jelly_bag/*.png filter=lfs diff=lfs merge=lfs -text
source/cyclo_lab/data/object/texture/peanut_mix_bag/*.png filter=lfs diff=lfs merge=lfs -text
source/cyclo_lab/data/object/texture/roasted_chestnut_bag/*.png filter=lfs diff=lfs merge=lfs -text

# Keep the primitive-only showroom human-readable and reviewable in Git.
source/cyclo_lab/data/environments/robotis_showroom/robotis_showroom.usda -filter -merge diff text

# Other rack packages retain their existing LFS rule.
source/cyclo_lab/data/objects/bread_slot/*.usdz filter=lfs diff=lfs merge=lfs -text
# Exact rack approved by the user for public upload; store as a regular Git blob.
source/cyclo_lab/data/objects/bread_slot/bread_slot.usdz -filter -diff -merge -text

# Preserve original CSV bytes used by recorded delivery SHA256 checks.
*.csv whitespace=cr-at-eol
# Unified diff context lines and the hashed generator snapshot are evidence.
scripts/tools/toast_scenario_geometry.py whitespace=-blank-at-eof

# Immutable generation evidence: preserve original whitespace bytes for SHA256 checks.
docs/release/generation_sources/*.source -whitespace

# Generated scenario layout cards; keep runtime HTML/JavaScript unchanged.
scenario_delivery/overview_cards.html linguist-generated=true
scenario_delivery_base/overview_cards.html linguist-generated=true
scenario_delivery_base_ptb/overview_cards.html linguist-generated=true
